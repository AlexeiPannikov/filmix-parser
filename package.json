{
  "name": "filmix-parser",
  "version": "1.0.0",
  "description": "Filmix client for TypeScript: search, post metadata and direct CDN link resolution",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./net/got-scraping": {
      "types": "./dist/net/got-scraping.d.ts",
      "import": "./dist/net/got-scraping.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "filmix": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "got-scraping": "^4.2.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "got-scraping": "^4.2.2"
  },
  "peerDependenciesMeta": {
    "got-scraping": {
      "optional": true
    }
  }
}
